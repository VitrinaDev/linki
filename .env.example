# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the Linki UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging)
HEADLESS=true

# Optional process-wide static proxy. Required automatically when RADAR_WORKFLOW_ID
# is configured. Keep one proxy and one LinkedIn account per Linki runtime.
LINKI_PROXY_SERVER=
LINKI_PROXY_USERNAME=
LINKI_PROXY_PASSWORD=
LINKI_REQUIRE_PROXY=false

# Radar integration. Create/authenticate the account and create a LinkedIn-only
# workflow in Linki first, then copy their IDs here. Templates may use
# {{icebreaker_context}} in addition to Linki's standard contact variables.
RADAR_WORKFLOW_ID=
RADAR_LINKEDIN_ACCOUNT_ID=
RADAR_LIST_ID=radar_vitrina_active_campaign
RADAR_CALLBACK_URL=https://radar.example.com/api/webhooks/v1/omnichannel-callback
RADAR_CALLBACK_SECRET=
RADAR_REPLY_SYNC_INTERVAL_MINUTES=15
